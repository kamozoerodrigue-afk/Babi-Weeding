# Expo fige React sur la version validee par le SDK (19.1.0 pour le SDK 54).
# Certaines dependances optionnelles - react-dom en tete - reclament une version
# plus recente et font echouer la resolution stricte de npm.
# Ces pairs optionnels ne sont pas embarques dans l'application mobile :
# on demande donc a npm la resolution souple, comme le recommande Expo.
legacy-peer-deps=true
